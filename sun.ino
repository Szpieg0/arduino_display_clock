void sunScreen(){
  if (needsRefresh == true){
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print(F("Sunrise and sunset"));
  display.setCursor(0,6);
  display.print(F("Warsaw"));

  display.setTextSize(2);

  display.drawBitmap(0, 20, sunIcon, 16, 16, SSD1306_WHITE);
  display.setCursor(24, 20);
  display.print(sunriseStr);

  display.drawBitmap(0, 44, moonIcon, 16, 16, SSD1306_WHITE);
  display.setCursor(24, 44);
  display.print(sunsetStr);
  display.display();
  needsRefresh = false;
  } else {
  return;
  }
}